# Copy to .env (optional). All values have sensible defaults.
PORT=3000
HOST=0.0.0.0
# Where the SQLite database and uploaded photos live
DATA_DIR=./data
# Seed fictional demo users/cats on first start (true/false)
DEMO_DATA=true
# Browser-side cat detector: "coco-ssd" (TensorFlow.js, loaded from CDN) or "off"
CAT_DETECTOR=coco-ssd
# Days without observation before a cat is shown as "not seen recently"
MISSING_AFTER_DAYS=30
# Set to true when serving over HTTPS so the session cookie is marked Secure
COOKIE_SECURE=false
