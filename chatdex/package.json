{
  "name": "chatdex",
  "version": "0.1.0",
  "private": true,
  "description": "Chatdex: gotta catch 'em cats. A social collection game for real-world cats.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "dev": "node --disable-warning=ExperimentalWarning server/index.js",
    "build": "vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning server/index.js",
    "seed": "node --disable-warning=ExperimentalWarning server/seed.js",
    "db:reset": "node --disable-warning=ExperimentalWarning server/seed.js --reset",
    "demo:clear": "node --disable-warning=ExperimentalWarning server/seed.js --clear-demo",
    "test": "node --disable-warning=ExperimentalWarning --test tests/api.test.js tests/i18n.test.js",
    "test:e2e": "node --disable-warning=ExperimentalWarning tests/e2e.mjs",
    "build:mobile": "node scripts/build-mobile.mjs",
    "cap:android": "npx cap open android",
    "cap:ios": "npx cap open ios"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/ios": "^8.5.2",
    "@fontsource-variable/nunito": "^5.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "express": "^5.2.1",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "vite": "^8.3.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "playwright-core": "^1.63.0"
  }
}
