# ============================================================
# Variables d'environnement du pipeline
# Pour un run local : copier ce fichier vers .env et remplir.
# Pour GitHub Actions : Settings > Secrets and variables > Actions
# (voir README.md — Secrets = valeurs sensibles, Variables = le reste)
# ============================================================

# === Google Gemini, rédaction du script (SECRET) ===
GOOGLE_API_KEY=...

# === Voix edge-tts (gratuit, aucune clé requise) ===
AZURE_VOICE_NAME=fr-FR-VivienneMultilingualNeural
PROSODY_RATE=0%

# === Cloudflare R2, hébergement MP3/texte/RSS (SECRETS) ===
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET=mon-bucket-podcast
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxx.r2.dev

# === PubMed / NCBI (optionnel mais recommandé) ===
NCBI_API_KEY=...
NCBI_TOOL=revue-quotidienne
NCBI_EMAIL=vous@exemple.ch

# === Notifications (optionnel) ===
SLACK_WEBHOOK_URL=
SLACK_NOTIFY=false
WHATSAPP_PHONE=
CALLMEBOT_API_KEY=

# === Métadonnées du podcast (flux 1, complet) ===
PODCAST_TITLE=Revue quotidienne
PODCAST_AUTHOR=Prénom
PODCAST_EMAIL=vous@exemple.ch
PODCAST_LANGUAGE=fr-FR
PODCAST_TIMEZONE=Europe/Zurich
PODCAST_DESCRIPTION=Revue quotidienne de l'actualité générale et scientifique.

# === Flux 2 (généraliste, partageable, optionnel) ===
EPISODE_PREFIX_GENERAL=episodes-general/
FEED_FILENAME_GENERAL=feed-general.xml
PODCAST_TITLE_GENERAL=Revue du jour
PODCAST_AUTHOR_GENERAL=Prénom
PODCAST_DESCRIPTION_GENERAL=Actualités générales et découvertes scientifiques en quelques minutes.
